{
  "name": "dsh-credit-hub",
  "version": "0.2.0",
  "type": "module",
  "description": "积分汇通 — 把各家 coding agent 的账号积分渠道（WorkBuddy/CodeBuddy、Raccoon 商汤小浣熊、Qoder、ZCode、MiniMax、TRAE 等）与自填的官方 API / 任意 OpenAI 兼容中转，汇成一条统一模型车道与一个本地 OpenAI + Anthropic 兼容网关；含账号池、积分查询、降级链与用量看板。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "vendor/channel-pack/pack.js",
    "vendor/channel-pack/qoder-auth-wasm.wasm",
    "vendor/channel-pack/NOTICE.md",
    "vendor/channel-pack/LICENSE",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "test"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "credit-hub",
    "llm-provider"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alex663028/dsh-credit-hub.git"
  },
  "homepage": "https://github.com/Alex663028/dsh-credit-hub#readme",
  "bugs": {
    "url": "https://github.com/Alex663028/dsh-credit-hub/issues"
  },
  "scripts": {
    "test": "node test/run.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": "^0.1.2-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
